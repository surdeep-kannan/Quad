{
  "name": "quad-tools",
  "private": true,
  "type": "module",
  "description": "Database tooling for Quad: local migration checks, applying migrations to Supabase and demo seeding.",
  "scripts": {
    "db:check": "node db-check.mjs",
    "db:migrate": "node --env-file=../.env db-migrate.mjs",
    "db:seed-demo": "node --env-file=../.env seed-demo.mjs",
    "livekit:setup": "node --env-file=../.env livekit-setup.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.117.2",
    "pg": "^8.23.0"
  }
}
